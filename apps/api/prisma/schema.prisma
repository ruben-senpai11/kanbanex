datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==============================================================================
// ENUMS
// ==============================================================================

enum SystemRole {
  SUPER_ADMIN
  USER
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ProjectRole {
  MANAGER
  CONTRIBUTOR
  VIEWER
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
}

enum DependencyType {
  FINISH_TO_START
  START_TO_START
  FINISH_TO_FINISH
  START_TO_FINISH
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELED
}

// ==============================================================================
// CORE IDENTITY & WORKSPACES
// ==============================================================================

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  passwordHash           String
  fullName               String
  avatarUrl              String?
  role                   SystemRole @default(USER)
  isEmailVerified        Boolean   @default(false)
  emailVerificationToken String?
  passwordResetToken     String?
  passwordResetExpires   DateTime?
  totpSecret             String?
  totpEnabled            Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  sessions               Session[]
  workspaceMembers       WorkspaceMember[]
  projectMembers         ProjectMember[]
  assignedTasks          TaskAssignee[]
  comments               Comment[]
  activityLogs           ActivityLog[]
  notifications          Notification[]
  attachments            Attachment[]

  @@map("users")
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  isRevoked  Boolean  @default(false)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Workspace {
  id           String            @id @default(uuid())
  name         String
  slug         String            @unique
  description  String?
  logoUrl      String?
  ownerId      String
  isArchived   Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  members      WorkspaceMember[]
  projects     Project[]
  labels       Label[]
  subscription Subscription?
  transactions PaymentTransaction[]
  activityLogs ActivityLog[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_members")
}

// ==============================================================================
// PROJECTS & VISUAL IDENTITY
// ==============================================================================

model Project {
  id               String        @id @default(uuid())
  workspaceId      String
  name             String
  slug             String
  description      String?
  status           ProjectStatus @default(PLANNING)
  priority         Priority      @default(MEDIUM)
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  coverUrl         String?
  customColor      String?       // Hex or Tailwind color token
  customGradient   String?       // Gradient CSS class or linear-gradient string
  backgroundTheme  String?       // Built-in cinematic themes: downhill, vast-skies, etc.
  ownerId          String
  isArchived       Boolean       @default(false)
  position         Float         @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members          ProjectMember[]
  boards           Board[]
  tasks            Task[]
  activityLogs     ActivityLog[]
  labels           Label[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(uuid())
  projectId String
  userId    String
  role      ProjectRole @default(CONTRIBUTOR)
  addedAt   DateTime    @default(now())

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

// ==============================================================================
// BOARDS, LISTS & TASKS (KANBAN / GANTT / CALENDAR)
// ==============================================================================

model Board {
  id        String   @id @default(uuid())
  projectId String
  name      String   @default("Principal")
  position  Float    @default(0)
  isDefault Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lists     List[]

  @@index([projectId])
  @@map("boards")
}

model List {
  id         String   @id @default(uuid())
  boardId    String
  name       String
  position   Float    @default(0)
  color      String?
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  board      Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks      Task[]

  @@index([boardId])
  @@map("lists")
}

model Task {
  id                 String          @id @default(uuid())
  listId             String
  projectId          String
  title              String
  description        String?
  position           Float           @default(0)
  status             TaskStatus      @default(TODO)
  priority           Priority        @default(MEDIUM)
  startDate          DateTime?
  dueDate            DateTime?
  dueTime            String?
  estimatedHours     Float?
  actualHours        Float?
  progressPercentage Int             @default(0)
  isArchived         Boolean         @default(false)
  completedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  list               List            @relation(fields: [listId], references: [id], onDelete: Cascade)
  project            Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignees          TaskAssignee[]
  labels             TaskLabel[]
  checklists         Checklist[]
  comments           Comment[]
  attachments        Attachment[]
  predecessors       TaskDependency[] @relation("SuccessorTask")
  successors         TaskDependency[] @relation("PredecessorTask")

  @@index([listId])
  @@index([projectId])
  @@index([dueDate])
  @@map("tasks")
}

model TaskAssignee {
  id         String   @id @default(uuid())
  taskId     String
  userId     String
  assignedAt DateTime @default(now())

  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@map("task_assignees")
}

model Label {
  id          String      @id @default(uuid())
  workspaceId String
  projectId   String?
  name        String
  color       String      // Hex or design color
  icon        String?
  description String?
  createdAt   DateTime    @default(now())

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskLabels  TaskLabel[]

  @@index([workspaceId])
  @@index([projectId])
  @@map("labels")
}

model TaskLabel {
  id      String @id @default(uuid())
  taskId  String
  labelId String

  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([taskId, labelId])
  @@index([taskId])
  @@index([labelId])
  @@map("task_labels")
}

model TaskDependency {
  id                String         @id @default(uuid())
  predecessorTaskId String
  successorTaskId   String
  dependencyType    DependencyType @default(FINISH_TO_START)
  createdAt         DateTime       @default(now())

  predecessor       Task           @relation("PredecessorTask", fields: [predecessorTaskId], references: [id], onDelete: Cascade)
  successor         Task           @relation("SuccessorTask", fields: [successorTaskId], references: [id], onDelete: Cascade)

  @@unique([predecessorTaskId, successorTaskId])
  @@index([predecessorTaskId])
  @@index([successorTaskId])
  @@map("task_dependencies")
}

model Checklist {
  id        String          @id @default(uuid())
  taskId    String
  title     String
  position  Float           @default(0)
  createdAt DateTime        @default(now())

  task      Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  items     ChecklistItem[]

  @@index([taskId])
  @@map("checklists")
}

model ChecklistItem {
  id          String    @id @default(uuid())
  checklistId String
  content     String
  isCompleted Boolean   @default(false)
  position    Float     @default(0)
  dueDate     DateTime?
  assigneeId  String?
  createdAt   DateTime  @default(now())

  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
  @@map("checklist_items")
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  content   String
  isEdited  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@map("comments")
}

model Attachment {
  id         String   @id @default(uuid())
  taskId     String
  uploaderId String
  fileName   String
  fileUrl    String
  fileType   String
  fileSize   Int
  createdAt  DateTime @default(now())

  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader   User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("attachments")
}

// ==============================================================================
// AUDIT & NOTIFICATIONS
// ==============================================================================

model ActivityLog {
  id          String    @id @default(uuid())
  workspaceId String
  projectId   String?
  taskId      String?
  userId      String
  action      String
  entityType  String
  entityId    String
  details     Json?
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([projectId])
  @@index([createdAt])
  @@map("activity_logs")
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  title      String
  message    String
  type       String
  entityType String?
  entityId   String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ==============================================================================
// BILLING, PLANS & FEDAPAY
// ==============================================================================

model SubscriptionPlan {
  id                  String          @id @default(uuid())
  slug                String          @unique // basic, eclosion, entreprise
  name                String
  description         String
  price               Int             // In currency units (e.g. 5000 FCFA)
  currency            String          @default("XOF")
  billingInterval     BillingInterval @default(MONTHLY)
  isCustomPrice       Boolean         @default(false)
  maxProjects         Int             @default(3) // -1 for unlimited
  maxMembersPerProject Int            @default(5) // -1 for unlimited
  features            Json            // JSON object with enabled entitlements
  isActive            Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  subscriptions       Subscription[]
  transactions        PaymentTransaction[]

  @@map("subscription_plans")
}

model Subscription {
  id                 String             @id @default(uuid())
  workspaceId        String             @unique
  planId             String
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@map("subscriptions")
}

model PaymentTransaction {
  id           String        @id @default(uuid())
  workspaceId  String
  planId       String
  provider     String        @default("FEDAPAY")
  providerTxId String?       @unique
  amount       Int
  currency     String        @default("XOF")
  status       PaymentStatus @default(PENDING)
  metadata     Json?
  createdAt    DateTime      @default(now())
  completedAt  DateTime?

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([providerTxId])
  @@map("payment_transactions")
}

// ==============================================================================
// SYSTEM SETTINGS (ADMIN CONFIGURABLE)
// ==============================================================================

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}
