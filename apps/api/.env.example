# ==============================================================================
# KANBANEX API CONFIGURATION ENVIRONNEMENT (.env.example)
# ==============================================================================

# Environnement & Ports
NODE_ENV=development
PORT=4000
FRONTEND_URL=https://kanbanex.vercel.app
APP_URL=https://kanbanex.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:4000

# Base de données PostgreSQL Neon
DATABASE_URL="postgresql://neondb_owner:[PASSWORD]@[ENDPOINT]-pooler.[REGION].neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://neondb_owner:[PASSWORD]@[ENDPOINT].[REGION].neon.tech/neondb?sslmode=require&channel_binding=require"

# Sécurité & Tokens JWT (générer 32+ caractères en production)
JWT_ACCESS_SECRET="kanbanex_access_secret_super_secure_key_change_in_production_32chars"
JWT_REFRESH_SECRET="kanbanex_refresh_secret_super_secure_key_change_in_production_32chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Passerelle de paiement FedaPay
FEDAPAY_API_KEY=""
FEDAPAY_ENV=sandbox
FEDAPAY_WEBHOOK_SECRET=""
FEDAPAY_WEBHOOK_URL="https://votre-api.onrender.com/api/v1/billing/fedapay/webhook"
FEDAPAY_RETURN_URL="https://kanbanex.vercel.app/billing?payment_status=return"

# ==============================================================================
# Configuration Email SMTP (Validation de compte & Notifications)
# ==============================================================================
# Exemples de providers SMTP :
# - Resend : SMTP_HOST="smtp.resend.com", SMTP_PORT=465 ou 587, SMTP_USER="resend", SMTP_PASS="re_votreCle"
# - Brevo (Sendinblue) : SMTP_HOST="smtp-relay.brevo.com", SMTP_PORT=587, SMTP_USER="votre-login", SMTP_PASS="votre-masterkey"
# - Gmail : SMTP_HOST="smtp.gmail.com", SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER="votre.email@gmail.com", SMTP_PASS="mot_de_passe_application_16_caracteres"
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM='"KanbanEx" <no-reply@kanbanex.vercel.app>'
