# ==============================================================================
# KANBANEX ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kanbanex?schema=public"

# Redis Cache & Sessions (Optional in dev)
REDIS_URL="redis://localhost:6379"

# Authentication & JWT Secrets
JWT_ACCESS_SECRET="kanbanex_access_secret_super_secure_key_change_in_production_32chars"
JWT_REFRESH_SECRET="kanbanex_refresh_secret_super_secure_key_change_in_production_32chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Argon2 Password Salt Key
PASSWORD_HASH_SALT="kanbanex_password_hash_salt_expansion"

# Super Admin Seed (Initial system seed)
SUPERADMIN_EMAIL="admin@kanbanex.expansion.io"
SUPERADMIN_PASSWORD="SuperAdmin123!Secure"
SUPERADMIN_NAME="Expansion SuperAdmin"

# S3 Compatible Object Storage (Cloudflare R2, MinIO, or AWS S3)
S3_ENDPOINT="https://s3.eu-west-1.amazonaws.com"
S3_REGION="eu-west-1"
S3_BUCKET="kanbanex-attachments"
S3_ACCESS_KEY_ID="your_s3_access_key"
S3_SECRET_ACCESS_KEY="your_s3_secret_key"
S3_PUBLIC_URL="https://storage.kanbanex.expansion.io"

# FedaPay Payment Gateway
FEDAPAY_SECRET_KEY="sk_sandbox_your_fedapay_secret_key"
FEDAPAY_PUBLIC_KEY="pk_sandbox_your_fedapay_public_key"
FEDAPAY_ENVIRONMENT="sandbox" # sandbox or live
FEDAPAY_WEBHOOK_SECRET="wh_secret_your_fedapay_webhook_secret"

# OAuth Google (Optional)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"

# Logging & Monitoring
LOG_LEVEL="info"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
