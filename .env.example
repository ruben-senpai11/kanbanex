# ==============================================================================
# KANBANEX CONFIGURATION ENVIRONNEMENT (.env.example)
# ==============================================================================

# Application & Domaines
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Base de données PostgreSQL Neon
# 1. DATABASE_URL : Chaîne avec Connection Pooling (PgBouncer) pour le runtime API
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT]-pooler.[REGION].neon.tech/neondb?sslmode=require&pgbouncer=true"

# 2. DIRECT_URL : Chaîne de connexion directe (sans pooler) pour les migrations Prisma
DIRECT_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT].[REGION].neon.tech/neondb?sslmode=require"

# Sécurité & Tokens JWT
JWT_ACCESS_SECRET="kanbanex_access_secret_super_secure_key_change_in_production_32chars"
JWT_REFRESH_SECRET="kanbanex_refresh_secret_super_secure_key_change_in_production_32chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Configuration Email SMTP (Validation de compte & Notifications)
# Exemples de providers SMTP :
# - Resend : SMTP_HOST="smtp.resend.com", SMTP_PORT=465 ou 587, SMTP_USER="resend", SMTP_PASS="re_votreCle"
# - Brevo (Sendinblue) : SMTP_HOST="smtp-relay.brevo.com", SMTP_PORT=587
# - Gmail : SMTP_HOST="smtp.gmail.com", SMTP_PORT=465, SMTP_SECURE=true (avec mot de passe d'application)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM='"KabanEx" <no-reply@kabanex.vercel.app>'
