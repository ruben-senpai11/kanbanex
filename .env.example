# ==============================================================================
# KANBANEX CONFIGURATION ENVIRONNEMENT (.env.example)
# ==============================================================================

# Application & Serveur
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Base de données PostgreSQL Neon
# 1. DATABASE_URL : Chaîne avec Connection Pooling (PgBouncer) pour le runtime
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT]-pooler.[REGION].neon.tech/neondb?sslmode=require&pgbouncer=true"

# 2. DIRECT_URL : Chaîne de connexion directe (sans pooler) pour les migrations Prisma
DIRECT_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT].[REGION].neon.tech/neondb?sslmode=require"

# Sécurité & Tokens JWT
JWT_ACCESS_SECRET="kanbanex_access_secret_super_secure_key_change_in_production_32chars"
JWT_REFRESH_SECRET="kanbanex_refresh_secret_super_secure_key_change_in_production_32chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Passerelle de paiement FedaPay
FEDAPAY_SECRET_KEY=""
FEDAPAY_PUBLIC_KEY=""
FEDAPAY_ENVIRONMENT="sandbox"
